[Unit]
Description=AXP20x Hardware Power Off
DefaultDependencies=no
# Ensure this runs after filesystems are unmounted but before the kernel halts
Before=poweroff.target halt.target final.target
# Prevemt this from running during a reboot
Conflicts=reboot.target kexec.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/libexec/axp-poweroff.sh
TimeoutStartSec=10
StandardOutput=kmsg
StandardError=kmsg

[Install]
WantedBy=poweroff.target halt.target
